@* wwwroot/report-templates/WeeklyReport.cshtml *@
@model WeeklyReportViewModel

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <script src="chart.umd.min.js"></script>
    <style>
        body {
        font-family: 'Segoe UI', Arial, sans-serif;
        padding: 40px;
        color: #2d3748;
        }

        h1 {
        color: #2c5282;
        font-size: 22px;
        margin-bottom: 30px;
        }

        .stats-row {
        display: flex;
        gap: 20px;
        margin-bottom: 40px;
        }

        .stat-box {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 15px 20px;
        flex: 1;
        text-align: center;
        }

        .stat-box .value {
        font-size: 24px;
        font-weight: bold;
        color: #2c5282;
        }

        .stat-box .label {
        font-size: 13px;
        color: #718096;
        margin-top: 5px;
        }

        .chart-section {
        margin-bottom: 50px;
        page-break-inside: avoid;
        }

        .chart-container {
        width: 100%;
        height: 280px;
        }

        h2 {
        font-size: 16px;
        color: #4a5568;
        margin-bottom: 15px;
        }

        .summary-section {
        margin-bottom: 40px;
        }

        .summary-grid {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        }

        .summary-box {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 15px 20px;
        flex: 1;
        min-width: 200px;
        text-align: center;
        }

        .summary-box .value {
        font-size: 20px;
        font-weight: bold;
        color: #2c5282;
        }

        .summary-box .label {
        font-size: 13px;
        color: #718096;
        margin-top: 5px;
        }
    </style>
</head>

<body>
    <h1>Rapport hebdomadaire — @Model.WeekStartFormatted au @Model.WeekEndFormatted</h1>

    <div class="stats-row">
        <div class="stat-box">
            <div class="value">@Model.TotalTicketsCreated</div>
            <div class="label">Tickets créés</div>
        </div>
        <div class="stat-box">
            <div class="value">@Model.TotalTicketsClosed</div>
            <div class="label">Tickets fermés</div>
        </div>
        <div class="stat-box">
            <div class="value">@Model.SlaRespectedPercent%</div>
            <div class="label">SLA respecté</div>
        </div>
        @if (Model.MeanResolutionTimeHours.HasValue)
        {
            <div class="stat-box">
                <div class="value">@Model.MeanResolutionTimeHours.Value.ToString("0.0")h</div>
                <div class="label">Temps moyen de résolution</div>
            </div>
        }
    </div>

    <div class="summary-section">
        <h2>Répartition par application</h2>
        <div class="summary-grid">
            <div class="summary-box">
                <div class="value">@Model.ApplicationCount</div>
                <div class="label">Applications concernées</div>
            </div>
            <div class="summary-box">
                <div class="value">@Model.TopApplication</div>
                <div class="label">Application la plus sollicitée (@Model.TopApplicationCount tickets)</div>
            </div>
        </div>
    </div>

    @if (Model.LastWeekSlaRate.HasValue && Model.PreviousWeekSlaRate.HasValue)
    {
        <div class="summary-section">
            <h2>Évolution sur les deux dernières semaines</h2>
            <div class="summary-grid">
                <div class="summary-box">
                    <div class="value">@Model.LastWeekTicketCount</div>
                    <div class="label">Tickets semaine dernière</div>
                </div>
                <div class="summary-box">
                    <div class="value">@Model.LastWeekSlaRate.Value.ToString("0.0")%</div>
                    <div class="label">SLA semaine dernière</div>
                </div>
                <div class="summary-box">
                    <div class="value">@Model.PreviousWeekSlaRate.Value.ToString("0.0")%</div>
                    <div class="label">SLA semaine précédente</div>
                </div>
                <div class="summary-box">
                    <div class="value" style="color: @(Model.SlaRateEvolution >= 0 ? "#2f855a" : "#c53030")">
                        @(Model.SlaRateEvolution >= 0 ? "+" : "")@Model.SlaRateEvolution.GetValueOrDefault().ToString("0.0")%
                    </div>
                    <div class="label">Évolution SLA</div>
                </div>
                <div class="summary-box">
                    <div class="value" style="color: @(Model.TicketCountEvolution >= 0 ? "#2f855a" : "#c53030")">
                        @(Model.TicketCountEvolution >= 0 ? "+" : "")@Model.TicketCountEvolution
                    </div>
                    <div class="label">Évolution nombre de tickets</div>
                </div>
            </div>
        </div>
    }

    <div class="chart-section">
        <h2>Répartition par application</h2>
        <div class="chart-container"><canvas id="priorityChart"></canvas></div>
    </div>

    <div class="chart-section">
        <h2>Volume hebdomadaire de tickets créés</h2>
        <div class="chart-container"><canvas id="volumeChart"></canvas></div>
    </div>

    <div class="chart-section">
        <h2>Respect du SLA</h2>
        <div class="chart-container"><canvas id="slaChart"></canvas></div>
    </div>

    <script>
        const chartData = __CHART_DATA_JSON__;

        Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";

        new Chart(document.getElementById('priorityChart'), {
        type: 'bar',
        data: {
        labels: chartData.ticketsByPriority.map(p => p.label),
        datasets: [{
        label: 'Tickets',
        data: chartData.ticketsByPriority.map(p => p.value),
        backgroundColor: '#2c5282'
        }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById('volumeChart'), {
        type: 'line',
        data: {
        labels: chartData.dailyVolume.map(d => d.label),
        datasets: [{
        label: 'Volume',
        data: chartData.dailyVolume.map(d => d.value),
        borderColor: '#2c5282',
        tension: 0.3
        }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById('slaChart'), {
        type: 'pie',
        data: {
        labels: chartData.slaBreakdown.map(s => s.label),
        datasets: [{
        data: chartData.slaBreakdown.map(s => s.value),
        backgroundColor: ['#2f855a', '#c53030']
        }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        window.chartsReady = true;
    </script>
</body>

</html>
